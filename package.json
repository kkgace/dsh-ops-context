{
  "name": "dsh-ops-context",
  "version": "0.5.0",
  "description": "Bounded, workspace-scoped context search and repeat-read suppression for DSH desktop and web. Cross-platform (Linux/macOS/Windows) — one package, no native deps.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./core": "./src/core.js",
    "./register": "./src/register.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "context",
    "workspace",
    "bounded-search",
    "read-dedup",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkgace/dsh-ops-context.git"
  },
  "homepage": "https://github.com/kkgace/dsh-ops-context",
  "author": {
    "name": "kkgace",
    "url": "https://github.com/kkgace"
  },
  "bugs": {
    "url": "https://github.com/kkgace/dsh-ops-context/issues"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/core.js && node --check src/register.js && node --check src/session-state.js && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
